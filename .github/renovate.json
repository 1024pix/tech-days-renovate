{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>1024pix/renovate-config:default",
    ":prHourlyLimitNone"
  ],
  "enabled": true,
  "packageRules": [
    {
      "description": "Neutralise group-by-directory : une seule PR par dependance, tous dossiers confondus",
      "matchPackageNames": ["/^eslint.*/", "/^prettier.*/"]
    }
  ]
}
