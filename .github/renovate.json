{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>1024pix/renovate-config:default",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions"
  ],
  "enabled": true,
  "customManagers": [
    {
      "description": "Track Spark version in PixSparkKubernetesOperator.py",
      "customType": "regex",
      "matchStrings": [
        "SPARK_VERSION = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "org.apache.spark:spark-core",
      "datasourceTemplate": "sbt-package",
      "managerFilePatterns": [
        "/folder-python-A/folder_python_a/helpers/PixSparkKubernetesOperator\\.py$/"
      ],
      "packageNameTemplate": "org.apache.spark:spark-core_2.12"
    },
    {
      "description": "Track JMX Prometheus agent version in PixSparkKubernetesOperator.py",
      "customType": "regex",
      "matchStrings": [
        "jmx_prometheus_javaagent-(?<currentValue>[\\d.]+)\\.jar"
      ],
      "depNameTemplate": "prometheus/jmx_exporter",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/folder-python-A/folder_python_a/helpers/PixSparkKubernetesOperator\\.py$/"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Famille spark (couplee) : image de base, deps sbt, spark-testing-base et SPARK_VERSION du DAG dans une seule PR ; 4.x exige Scala 2.13",
      "matchPackageNames": [
        "spark",
        "/^org\\.apache\\.spark:/",
        "/^com\\.holdenkarau:spark-/"
      ],
      "groupName": "spark",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "allowedVersions": "/^3\\./"
    },
    {
      "description": "Famille jmx-prometheus (couplee) : ENV du Dockerfile et chemin du JAR dans le DAG",
      "matchDepNames": [
        "prometheus/jmx_exporter"
      ],
      "groupName": "jmx-prometheus",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    },
    {
      "description": "Famille airflow (couplee) : apache-airflow, ses providers et l'image apache/airflow du Dockerfile local",
      "matchPackageNames": [
        "apache/airflow",
        "/^apache-airflow/"
      ],
      "groupName": "airflow",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Famille python (couplee) : .python-version ; requires-python et le suffixe -pythonX.Y du tag airflow restent manuels",
      "matchDepNames": [
        "python"
      ],
      "groupName": "python",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "allowedVersions": "/^3\\.12/"
    },
    {
      "description": "Famille toolchain-jvm (couplee) : Scala de build.sbt et du tag de l'image sbt, sbt de build.properties et du tag, JDK de l'image de build et de la CI",
      "matchPackageNames": [
        "org.scala-lang:scala-library",
        "sbt/sbt",
        "java-jdk",
        "eclipse-temurin"
      ],
      "groupName": "toolchain-jvm",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMinorPatch": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Scala : binaire 2.12 impose par Spark 3.5",
      "matchPackageNames": [
        "org.scala-lang:scala-library"
      ],
      "allowedVersions": "/^2\\.12\\./"
    },
    {
      "description": "JDK : 17 impose par Spark 3.5, et par le java17 du tag spark: qui n'est pas trackable separement",
      "matchPackageNames": [
        "java-jdk",
        "eclipse-temurin"
      ],
      "allowedVersions": "/^17($|\\.)/"
    },
    {
      "description": "Famille outillage-python (confort) : ruff, pytest et ses plugins, dans [dependency-groups] dev",
      "matchDepTypes": [
        "dependency-groups",
        "tool.uv.dev-dependencies"
      ],
      "matchPackageNames": [
        "ruff",
        "pytest",
        "/^pytest-/"
      ],
      "groupName": "outillage-python"
    },
    {
      "description": "Famille outillage-scala (confort) : plugins sbt de project/plugins.sbt et version scalafmt de .scalafmt.conf",
      "matchDepNames": [
        "scalafmt",
        "/:sbt-/"
      ],
      "groupName": "outillage-scala"
    },
    {
      "description": "Famille tests-scala (confort) : scalatest et scalactic, publies ensemble et toujours a la meme version",
      "matchPackageNames": [
        "/^org\\.scalatest:/",
        "/^org\\.scalactic:/"
      ],
      "groupName": "tests-scala",
      "separateMinorPatch": false
    },
    {
      "description": "Famille github-actions (confort) : les refs d'actions des workflows, hors variables *_VERSION annotees",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMajorMinor": false,
      "separateMultipleMajor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Famille orbs-circleci (confort) : orbs de config.yml et continue_config.yml",
      "matchDatasources": [
        "orb"
      ],
      "groupName": "orbs-circleci",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": ""
    },
    {
      "description": "Famille postgresql (une PR par dependance) : driver JDBC de build.sbt ; l'addon Scalingo est gere par les presets partages",
      "matchPackageNames": [
        "/^org\\.postgresql:/"
      ],
      "groupName": null
    },
    {
      "description": "Famille lockfile (confort) : rafraichissement hebdomadaire des lockfiles, workspaces uv et package-lock confondus",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "groupName": "lockfile",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": ""
    },
    {
      "description": "Neutralise group-by-directory : une seule PR par dependance, tous dossiers confondus",
      "matchPackageNames": [
        "/^eslint.*/"
      ],
      "groupName": "eslint",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    },
    {
      "description": "Neutralise group-by-directory : une seule PR par dependance, tous dossiers confondus",
      "matchPackageNames": [
        "/^prettier.*/"
      ],
      "groupName": "prettier",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    },
    {
      "matchPackageNames": [
        "/^sinon.*/"
      ],
      "groupName": "sinon",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    },
    {
      "matchPackageNames": [
        "/^qunit.*/"
      ],
      "groupName": "qunit",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@1024pix/pix-ui"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "pix-ui",
      "prConcurrentLimit": 0
    }
  ]
}
