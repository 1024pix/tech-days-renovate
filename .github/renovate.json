{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>1024pix/renovate-config:default",
    ":prHourlyLimitNone",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions"
  ],
  "enabled": true,
  "prConcurrentLimit": 20,
  "customManagers": [
    {
      "description": "Track Spark version in PixSparkKubernetesOperator.py",
      "customType": "regex",
      "matchStrings": [
        "SPARK_VERSION = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "org.apache.spark:spark-core",
      "datasourceTemplate": "sbt-package",
      "managerFilePatterns": [
        "/folder-python-A/folder_python_a/helpers/PixSparkKubernetesOperator\\.py$/"
      ],
      "packageNameTemplate": "org.apache.spark:spark-core_2.12"
    },
    {
      "description": "Track JMX Prometheus agent version in PixSparkKubernetesOperator.py",
      "customType": "regex",
      "matchStrings": [
        "jmx_prometheus_javaagent-(?<currentValue>[\\d.]+)\\.jar"
      ],
      "depNameTemplate": "prometheus/jmx_exporter",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/folder-python-A/folder_python_a/helpers/PixSparkKubernetesOperator\\.py$/"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Spark : image de base, deps sbt et constante du DAG doivent bouger ensemble ; 4.x exige Scala 2.13",
      "matchPackageNames": [
        "spark",
        "/^org\\.apache\\.spark:/"
      ],
      "groupName": "spark",
      "allowedVersions": "/^3\\./"
    },
    {
      "description": "Scala : binaire 2.12 impose par Spark 3.5 (build.sbt et tag de l'image sbt)",
      "matchPackageNames": [
        "org.scala-lang:scala-library"
      ],
      "groupName": "scala",
      "allowedVersions": "/^2\\.12\\./"
    },
    {
      "description": "JDK : image de build, image runtime et JDK de CI alignes sur 17",
      "matchPackageNames": [
        "java-jdk",
        "eclipse-temurin"
      ],
      "groupName": "java",
      "allowedVersions": "/^17($|\\.)/"
    },
    {
      "description": "Agent JMX : version du Dockerfile et chemin du JAR dans le DAG",
      "matchPackageNames": [
        "prometheus/jmx_exporter"
      ],
      "groupName": "jmx exporter"
    },
    {
      "description": "Neutralise group-by-directory : une seule PR par dependance, tous dossiers confondus",
      "matchPackageNames": [
        "/^eslint.*/"
      ],
      "groupName": "eslint",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    },
    {
      "description": "Neutralise group-by-directory : une seule PR par dependance, tous dossiers confondus",
      "matchPackageNames": [
        "/^prettier.*/"
      ],
      "groupName": "prettier",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    },
    { "matchPackageNames": ["/^sinon.*/"],
      "groupName": "sinon",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    },
    {
      "matchPackageNames": ["/^qunit.*/"],
      "groupName": "qunit",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    }
  ]
}
